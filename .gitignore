# Generated by tools/install_launchers_*.sh — rebuilt by re-running the script,
# README included
launchers/

# Generated by tools/install_app_bundle_macos.sh, when built inside this
# directory. The default build puts it at the root of the installation instead,
# which the repository's own .gitignore has to cover.
*.app/

# Local backup archives of the application
SAM2_GUI_*.zip
VOLUTE_*.zip

# Corpus exported by tools/comment_audit/audit_comments.py --dump, rebuilt by
# re-running it
comment_audit/fragments.jsonl
comment_audit/fragments.tsv

# Claude Code session data
.claude/

# Python bytecode and macOS folder metadata (also covered repository-wide)
__pycache__/
*.py[cod]
.DS_Store
